<!--
  MCP de conhecimento — política de entrada
  - Valida token Entra ID (agente ou OBO do usuário)
  - Exige cabeçalho x-demanda (vínculo com a demanda no Azure Boards)
  - Limite de chamadas por agente (appid/azp) + demanda
  - Propaga identidade/grupos ao servidor MCP, que aplica o filtro de grupos
-->
<policies>
  <inbound>
    <base />
    <validate-azure-ad-token tenant-id="{{tenant-id}}" header-name="Authorization" failed-validation-httpcode="401" output-token-variable-name="jwt">
      <audiences>
        <audience>{{api-audience}}</audience>
      </audiences>
    </validate-azure-ad-token>
    <check-header name="x-demanda" failed-check-httpcode="400" failed-check-error-message="Cabeçalho x-demanda obrigatório" ignore-case="true" />
    <set-variable name="agentId" value="@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("azp", ((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("appid", "desconhecido")))" />
    <rate-limit-by-key calls="600" renewal-period="60" counter-key="@((string)context.Variables["agentId"] + "|" + context.Request.Headers.GetValueOrDefault("x-demanda",""))" />
    <set-header name="x-agent-id" exists-action="override">
      <value>@((string)context.Variables["agentId"])</value>
    </set-header>
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
